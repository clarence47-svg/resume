LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
PROFILE_MODEL=gpt-4.1-mini
MATCH_MODEL=
DATABASE_URL=sqlite:///data/profile-agent.db
CHECKPOINT_URL=sqlite:///data/langgraph-checkpoints.sqlite
DATA_DIR=data
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8080
AGENT_URL=http://127.0.0.1:8080
MAX_FILES=20
MAX_FILE_SIZE_MB=50
MAX_TOTAL_SIZE_MB=200
MAX_TOTAL_PAGES=500
PROFILE_WORKERS=1
MATCH_WORKERS=1
CAREER_WORKERS=1
JOB_SEARCH_ENABLED=true
JOB_SEARCH_ENDPOINT=http://www.baidu.com/s
JOB_SEARCH_FALLBACK_ENDPOINT=https://www.bing.com/search
JOB_SEARCH_MAX_RESULTS=8
JOB_SEARCH_TIMEOUT_SECONDS=12
COMPETITION_VERIFICATION_ENABLED=true
COMPETITION_VERIFICATION_MIN_SCORE=0.58
COMPETITION_VERIFICATION_MAX_RESULTS=6
OCR_ENABLED=true
ALLOW_HEURISTIC_FALLBACK=true
APP_ENCRYPTION_KEY=
CHROME_CDP_URL=http://host.docker.internal:9222
BROWSER_AUTOMATION_ENABLED=false
BROWSER_ACTION_TIMEOUT_SECONDS=30
BOSS_DAILY_ACTION_LIMIT=10
BOSS_ACTION_INTERVAL_MIN_SECONDS=90
BOSS_ACTION_INTERVAL_MAX_SECONDS=180
BOSS_DISCOVERY_MAX_JOBS=10
LOG_LEVEL=INFO
